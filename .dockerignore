# Environment and secrets (including the example template -- the
# image should not ship a template for operators to misread as a
# functioning .env)
.env
.env.*
.env.example
.api-key
.api-key-hash
.doci-api-key

# Git
.git
.gitignore

# Development
docker-compose*.yml
Dockerfile
.dockerignore
tests/
DATABASE.md
README.md
MEMORY.md
CLAUDE.md
CHANGELOG.md

# Logs
*.log
error_log
logs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# PHP dev
vendor/
composer.lock
composer.phar
.phpunit.*

