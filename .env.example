# DOCI Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
DB_HOST=common-postgres
DB_PORT=5432
DB_NAME=doci
DB_USER=doci_app
# Generate secure password: openssl rand -base64 32
DOCI_DB_PASS=your_secure_password_here

# =============================================================================
# API Authentication
# =============================================================================
# For CLI access, generate API key hash:
#   API_KEY=$(openssl rand -base64 32)
#   echo -n "$API_KEY" | sha256sum | cut -d' ' -f1
# Then use the key in X-API-Key header
DOCI_API_KEY_HASH=

# Enforce CSRF tokens on browser-flow POST/PUT/DELETE.
# Default = false (gate is being hardened in Phase 5 of the roadmap).
# Set to true to opt in; the UI already attaches X-CSRF-Token, but custom
# clients hitting the API without X-API-Key must include the token too.
DOCI_CSRF_ENABLED=false

# =============================================================================
# AI provider (optional)
# =============================================================================
# DOCI calls an OpenAI-compatible /chat/completions endpoint to power
# thread AI responses. Leave AI_GATEWAY_URL empty to disable AI
# features entirely (the AI checkbox will simply have no effect).
#
# Examples:
#   OpenAI:     AI_GATEWAY_URL=https://api.openai.com/v1
#   OpenRouter: AI_GATEWAY_URL=https://openrouter.ai/api/v1
#   Together:   AI_GATEWAY_URL=https://api.together.xyz/v1
#   Groq:       AI_GATEWAY_URL=https://api.groq.com/openai/v1
#   Ollama:     AI_GATEWAY_URL=http://localhost:11434/v1
#   llama.cpp:  AI_GATEWAY_URL=http://localhost:8080/v1
AI_GATEWAY_URL=
AI_API_KEY=
AI_GATEWAY_TIMEOUT=120
# Set to false ONLY for development with self-signed certs
AI_GATEWAY_SSL_VERIFY=true

# Friendly model aliases. The thread modal lets users pick haiku /
# sonnet / opus; map each to the provider-specific model id you want
# to use (or leave unset to hide that option in the UI).
# Examples for OpenRouter:
#   AI_MODEL_HAIKU=anthropic/claude-3.5-haiku
#   AI_MODEL_SONNET=anthropic/claude-3.5-sonnet
#   AI_MODEL_OPUS=anthropic/claude-3-opus
# Examples for OpenAI:
#   AI_MODEL_HAIKU=gpt-4o-mini
#   AI_MODEL_SONNET=gpt-4o
#   AI_MODEL_OPUS=o1
AI_MODEL_HAIKU=
AI_MODEL_SONNET=
AI_MODEL_OPUS=

# =============================================================================
# Application URLs
# =============================================================================
# Full URL to this application (for generating links)
APP_URL=https://doci.example.com
# Auth provider URL (for logout redirect)
AUTH_URL=https://auth.example.com
# External scripts CDN (leave empty to disable)
EXTERNAL_SCRIPTS_URL=

# =============================================================================
# Application Settings
# =============================================================================
# Domain for Traefik routing (your actual domain)
DOCI_DOMAIN=doci.example.com

# Logging (set to true for debug mode)
DOCI_DEBUG=false
DOCI_LOG_FILE=/var/log/doci/app.log

# Timezone
TZ=America/Chicago
