# DOCI Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=doci
DB_USER=doci_app
# Generate secure password: openssl rand -base64 32
DOCI_DB_PASS=your_secure_password_here

# Seconds the container entrypoint waits for the DB to accept
# connections before bailing out (default 60). Increase if your
# DB takes longer to come up after compose-up; the entrypoint
# applies migrations synchronously and Apache will not start
# until the wait succeeds.
DOCI_DB_WAIT_TIMEOUT=60

# =============================================================================
# API Authentication
# =============================================================================
# For CLI access, generate API key and bcrypt hash:
#   php scripts/hash-api-key.php
# (prints the key for clients + the DOCI_API_KEY_HASH value)
#
# Pass the key in the X-API-Key header. Only bcrypt hashes are
# accepted ($2y$ / $2a$ / $2b$ prefix). v0.1 SHA-256 hashes are
# refused; rotate with `php scripts/hash-api-key.php "<your-key>"`.
DOCI_API_KEY_HASH=

# Enforce CSRF tokens on browser-flow POST/PUT/DELETE. Default = true.
# The DOCI UI already attaches X-CSRF-Token. API-key callers are
# exempt (no browser session to hijack), so flip to false only if
# your deployment exposes the API exclusively via X-API-Key with no
# browser flow at all.
DOCI_CSRF_ENABLED=true

# =============================================================================
# AI provider (optional)
# =============================================================================
# DOCI calls an OpenAI-compatible /chat/completions endpoint to power
# thread AI responses. Leave AI_GATEWAY_URL empty to disable AI
# features entirely (the AI checkbox will simply have no effect).
#
# Examples:
#   OpenAI:     AI_GATEWAY_URL=https://api.openai.com/v1
#   OpenRouter: AI_GATEWAY_URL=https://openrouter.ai/api/v1
#   Together:   AI_GATEWAY_URL=https://api.together.xyz/v1
#   Groq:       AI_GATEWAY_URL=https://api.groq.com/openai/v1
#   Ollama:     AI_GATEWAY_URL=http://localhost:11434/v1
#   llama.cpp:  AI_GATEWAY_URL=http://localhost:8080/v1
AI_GATEWAY_URL=
AI_API_KEY=
AI_GATEWAY_TIMEOUT=120
# Set to false ONLY for development with self-signed certs
AI_GATEWAY_SSL_VERIFY=true

# Friendly model aliases. The thread modal lets users pick haiku /
# sonnet / opus; map each to the provider-specific model id you want
# to use (or leave unset to hide that option in the UI).
# Examples for OpenRouter:
#   AI_MODEL_HAIKU=anthropic/claude-3.5-haiku
#   AI_MODEL_SONNET=anthropic/claude-3.5-sonnet
#   AI_MODEL_OPUS=anthropic/claude-3-opus
# Examples for OpenAI:
#   AI_MODEL_HAIKU=gpt-4o-mini
#   AI_MODEL_SONNET=gpt-4o
#   AI_MODEL_OPUS=o1
AI_MODEL_HAIKU=
AI_MODEL_SONNET=
AI_MODEL_OPUS=

# =============================================================================
# Application URLs
# =============================================================================
# Full URL to this application (for generating links)
APP_URL=https://doci.example.com
# Auth provider URL (for logout redirect)
AUTH_URL=https://auth.example.com
# External scripts CDN (leave empty to disable)
EXTERNAL_SCRIPTS_URL=

# =============================================================================
# Application Settings
# =============================================================================
# Domain for Traefik routing (your actual domain)
DOCI_DOMAIN=doci.example.com

# Environment flag. Set to "development" for local dev; leave at
# "production" for any deployed instance. Required to be "development"
# before DOCI_DEV_AUTO_AUTH can take effect.
DOCI_ENV=production

# Comma-separated list of IPv4 addresses / CIDR ranges that are
# allowed to set the Remote-User header. Any request from outside
# this list has the Remote-User header stripped before reaching the
# handler -- this prevents anyone reaching the container directly
# (e.g. on traefik-net, or via the published port) from forging the
# header and authenticating as an arbitrary user.
#
# Examples:
#   DOCI_TRUSTED_PROXIES=172.20.0.0/16          # docker bridge network
#   DOCI_TRUSTED_PROXIES=10.0.0.5,10.0.0.6      # specific reverse proxies
#   DOCI_TRUSTED_PROXIES=none                   # explicit API-key-only mode
#   DOCI_TRUSTED_PROXIES=0.0.0.0/0              # DEV ONLY -- trust everyone
#
# REQUIRED when DOCI_ENV=production. Empty or 0.0.0.0/0 in production
# is a fatal startup error. Use "none" to declare "no proxy trusted,
# API-key only" explicitly.
DOCI_TRUSTED_PROXIES=none

# Dev-mode auto-authentication. When true AND DOCI_ENV=development,
# any unauthenticated browser request is authenticated as user "dev".
# DO NOT enable in production -- the app will refuse to start serving
# requests if DOCI_DEV_AUTO_AUTH=true without DOCI_ENV=development.
DOCI_DEV_AUTO_AUTH=false

# Application log threshold. One of: ERROR | WARN | INFO | DEBUG.
# WARN is the production default. Security-relevant actions
# (auth.*, csrf.*, *.delete.*, *.api_key_*) log regardless of the
# threshold so the audit trail is never silenced.
DOCI_LOG_LEVEL=WARN
DOCI_LOG_FILE=/var/log/doci/app.log

# Timezone
TZ=UTC
