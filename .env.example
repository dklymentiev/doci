# DOCI Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
DB_HOST=common-postgres
DB_PORT=5432
DB_NAME=doci
DB_USER=doci_app
# Generate secure password: openssl rand -base64 32
DOCI_DB_PASS=your_secure_password_here

# =============================================================================
# API Authentication
# =============================================================================
# For CLI access, generate API key hash:
#   API_KEY=$(openssl rand -base64 32)
#   echo -n "$API_KEY" | sha256sum | cut -d' ' -f1
# Then use the key in X-API-Key header
DOCI_API_KEY_HASH=

# =============================================================================
# AI Gateway
# =============================================================================
AI_GATEWAY_URL=https://ai.example.com/api/v1
AI_GATEWAY_TIMEOUT=120
# Set to false ONLY for development with self-signed certs
AI_GATEWAY_SSL_VERIFY=true

# =============================================================================
# Application URLs
# =============================================================================
# Full URL to this application (for generating links)
APP_URL=https://doci.example.com
# Auth provider URL (for logout redirect)
AUTH_URL=https://auth.example.com
# External scripts CDN (leave empty to disable)
EXTERNAL_SCRIPTS_URL=

# =============================================================================
# Application Settings
# =============================================================================
# Domain for Traefik routing (your actual domain)
DOCI_DOMAIN=doci.example.com

# Logging (set to true for debug mode)
DOCI_DEBUG=false
DOCI_LOG_FILE=/var/log/doci/app.log

# Timezone
TZ=America/Chicago
