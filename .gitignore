# Environment files (contain secrets)
.env
.api-key
.api-key-hash
.doci-api-key

# Logs
*.log
error_log
logs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# PHP
vendor/
composer.lock
composer.phar
.phpunit.cache/
.phpunit.result.cache

# Debug
test-*.php
debug.php

# Runtime document storage. The hidden dot-directories underneath
# files/ are operator state (the git working tree under .git/, thread
# and version snapshots under .data/, etc.) and are never committed.
# Seed content that ships with the OSS repo is whitelisted explicitly.
files/*
!files/.gitkeep
!files/README.md
!files/docs/
!files/farm/
!files/assets/
